{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {"builder": "RAILPACK"},
  "deploy": {
    "startCommand": "python academy_v2_launcher.py",
    "preDeployCommand": ["python -W ignore::ResourceWarning -m unittest discover -s tests -v"],
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
